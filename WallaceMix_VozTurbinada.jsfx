ds1_gr_w = min(240, max(0, (-ds1_gr / 15) * 240));
draw_rect_fill(30, 437, ds1_gr_w, 9, 0xbb00ff);

draw_section_panel(300, 336, 260, 118, "DE-ESSER 2 (ASPEREZA)");
gui_slider_v(12, 315, 358, 70, 72, 8000, 12000, 10000, "Freq", "Hz", 0xd844ff);
gui_slider_v(13, 395, 358, 70, 72, -50, -10, -26, "Thresh", "dB", 0xd844ff);
