desc:Wallacemix Master Processor v1.0 [Glue Comp/Tilt EQ/LUFS Trim]
// Copyright (c) 2026 Wallace Fernandes //
// MIT License - see LICENSE
// ============================================================
// Wallacemix Master Processor v1.0 - Processador de Master Profissional
// Autor: Wallace Fernandes
// ============================================================

slider1:threshold_db=-12<-40,0,0.1>Threshold (dB)
slider2:ratio=2<1,10,0.05>Ratio
slider3:knee_db=6<0,24,0.1>Knee (dB)
slider4:attack_ms=15<0.5,200,0.5>Attack (ms)
slider5:release_ms=150<10,2000,1>Release (ms)
slider6:makeup_db=0<-12,24,0.1>Makeup (dB)
slider7:mix=100<0,100,1>Mix (%)
slider8:bypass=0<0,1,1{Off,On}>Bypass

slider9:tilt_freq=1000<200,5000,10>Tilt Pivot (Hz)
slider10:tilt_db=3<-12,12,0.1>Tilt (dB, - escuro / + brilhante)
slider11:tilt_bypass=0<0,1,1{Off,On}>Tilt Bypass

slider12:ms_width=100<0,200,1>M/S Width (%)
slider13:ms_bypass=0<0,1,1{Off,On}>M/S Bypass

slider14:sc_hpf_freq=250<20,500,5>Sidechain HPF (Hz)
slider15:max_gr_db=12<1,20,0.1>Max GR Clamp (dB)

slider16:platform_sel=3<0,3,1{Rádio (-16 LUFS),YouTube (-14 LUFS),Podcast (-16 LUFS),Carro de Som (-9 LUFS)}>Plataforma
slider17:manual_trim_db=0<-12,12,0.1>Trim Manual (dB)
slider18:trim_speed=2<0.5,10,0.1>Velocidade do Trim (dB/s)
slider19:trim_bypass=0<0,1,1{Off,On}>LUFS Trim Bypass
slider20:out_trim_db=-2<-12,6,0.1>Trim Final de Saída (dB)

@init
env_db  = -100;
gr_db   = 0;
ms      = 0;
lpL     = 0;
lpR     = 0;
midEnv  = 0;
sideEnv = 0;
scL_lp  = 0;
scR_lp  = 0;

// --- estado do K-weighting (ITU-R BS.1770, coeficientes calibrados p/ 48kHz) ---
k1Lw1 = 0; k1Lw2 = 0;
k1Rw1 = 0; k1Rw2 = 0;
k2Lw1 = 0; k2Lw2 = 0;
k2Rw1 = 0; k2Rw2 = 0;
msq_fast    = 0.0000000001;
msq_slow    = 0.0000000001;
trim_db_cur = 0;
warm_n      = 0;

@slider
mk      = 10^(makeup_db/20);
att_c   = exp(-1/(0.001*attack_ms*srate));
rel_c   = exp(-1/(0.001*release_ms*srate));
mix_amt = mix/100;
half_kn = knee_db*0.5;
rms_c   = exp(-1/(0.001*5*srate)); // janela ~5ms: mata "grab" em picos isolados
sc_a    = exp(-2*$pi*sc_hpf_freq/srate); // HPF do detector (sidechain) - não afeta o áudio

tilt_a  = exp(-2*$pi*tilt_freq/srate);
tilt_lo = 10^(-tilt_db*0.5/20);
tilt_hi = 10^(tilt_db*0.5/20);

width_amt   = ms_width/100;
disp_smooth = exp(-1/(0.001*50*srate)); // ~50ms, só pra leitura no gfx

// --- coeficientes K-weighting (ITU-R BS.1770), selecionados pela taxa real do projeto ---
abs(srate-44100) < 1000 ? (
  k1_b0=1.530841230050348;  k1_b1=-2.650979995154729; k1_b2=1.169079079921587;
  k1_a1=-1.663655113256020; k1_a2=0.712595428073225;
  k2_b0=0.999560064542514;  k2_b1=-1.999120129085029; k2_b2=0.999560064542514;
  k2_a1=-1.989169673629796; k2_a2=0.989199035787039;
  kw_calibrated=1;
) : abs(srate-48000) < 1000 ? (
  k1_b0=1.53512485958697;  k1_b1=-2.69169618940638; k1_b2=1.19839281085285;
  k1_a1=-1.69065929318241; k1_a2=0.73248077421585;
  k2_b0=1.0; k2_b1=-2.0; k2_b2=1.0;
  k2_a1=-1.99004745483398; k2_a2=0.99007225036621;
  kw_calibrated=1;
) : abs(srate-88200) < 2000 ? (
  k1_b0=1.557515375579654; k1_b1=-2.905627079926345; k1_b2=1.361333977472212;
  k1_a1=-1.830919987962332; k1_a2=0.844142261087853;
  k2_b0=1.002271963357382; k2_b1=-2.004543926714764; k2_b2=1.002271963357382;
  k2_a1=-1.994577515450344; k2_a2=0.994584875878055;
  kw_calibrated=1;
) : abs(srate-96000) < 2000 ? (
  k1_b0=1.559714228975796; k1_b1=-2.926741578251082; k1_b2=1.378261202315819;
  k1_a1=-1.844609469890109; k1_a2=0.855843322930641;
  k2_b0=1.002492788986343; k2_b1=-2.004985577972686; k2_b2=1.002492788986343;
  k2_a1=-1.995017544724716; k2_a2=0.995023759040923;
  kw_calibrated=1;
) : (
  // taxa não-padrão: usa 48kHz como aproximação e sinaliza no gfx
  k1_b0=1.53512485958697;  k1_b1=-2.69169618940638; k1_b2=1.19839281085285;
  k1_a1=-1.69065929318241; k1_a2=0.73248077421585;
  k2_b0=1.0; k2_b1=-2.0; k2_b2=1.0;
  k2_a1=-1.99004745483398; k2_a2=0.99007225036621;
  kw_calibrated=0;
);

msq_fast_c    = exp(-1/(0.4*srate));  // janela momentânea ~400ms (padrão de referência p/ leitura)
msq_slow_c    = exp(-1/(3.0*srate));  // janela ~3s: evita "gain riding" audível no trim
max_trim_step = trim_speed/srate;     // dB de variação máxima permitida por amostra
warm_len      = 6.0*srate;            // ~6s (2x a janela lenta) pra medição "esquentar" antes do trim agir

platform_sel == 0 ? ( target_lufs = -16; ) :
platform_sel == 1 ? ( target_lufs = -14; ) :
platform_sel == 2 ? ( target_lufs = -16; ) :
                     ( target_lufs = -9;  );

@sample

// --- sidechain HPF: filtra só o DETECTOR, não o áudio (grave não "puxa" GR) ---
scL_lp = (1-sc_a)*spl0 + sc_a*scL_lp;
scR_lp = (1-sc_a)*spl1 + sc_a*scR_lp;
sc0    = spl0 - scL_lp;
sc1    = spl1 - scR_lp;

bypass == 0 ? (

  // --- detecção: RMS suavizado L+R do sinal filtrado (link estéreo, "glue") ---
  inst_sq = (sc0*sc0 + sc1*sc1) * 0.5;
  ms      = rms_c*(ms - inst_sq) + inst_sq;
  in_lvl  = sqrt(ms);
  in_db   = in_lvl > 0.0000000001 ? 20*log10(in_lvl) : -200;

  // --- envelope follower em dB (attack/release assimétrico) ---
  in_db > env_db ? (
    env_db = att_c*(env_db - in_db) + in_db;
  ) : (
    env_db = rel_c*(env_db - in_db) + in_db;
  );

  // --- curva de compressão com soft-knee ---
  delta = env_db - threshold_db;
  delta <= -half_kn ? (
    gr_db = 0;
  ) : delta >= half_kn ? (
    gr_db = delta - delta/ratio;
  ) : (
    // interpolação quadrática dentro da região de knee
    kn_pos = delta + half_kn;
    gr_db  = (kn_pos*kn_pos) / (2*knee_db) * (1 - 1/ratio);
  );

  // --- clamp de segurança: nunca "soca" além do limite definido ---
  gr_db = min(gr_db, max_gr_db);

  gr_lin = 10^(-gr_db/20);

  dry0 = spl0;
  dry1 = spl1;

  wet0 = spl0 * gr_lin * mk;
  wet1 = spl1 * gr_lin * mk;

  spl0 = dry0*(1-mix_amt) + wet0*mix_amt;
  spl1 = dry1*(1-mix_amt) + wet1*mix_amt;

) : (
  gr_db = 0;
);

// --- Tilt EQ: filtro de assinatura sonora, pivô configurável ---
tilt_bypass == 0 ? (
  lpL = (1-tilt_a)*spl0 + tilt_a*lpL;
  lpR = (1-tilt_a)*spl1 + tilt_a*lpR;
  hpL = spl0 - lpL;
  hpR = spl1 - lpR;
  spl0 = lpL*tilt_lo + hpL*tilt_hi;
  spl1 = lpR*tilt_lo + hpR*tilt_hi;
);

// --- M/S Width Control ---
mid  = (spl0+spl1)*0.5;
side = (spl0-spl1)*0.5;

ms_bypass == 0 ? (
  side = side*width_amt;
  spl0 = mid+side;
  spl1 = mid-side;
);

// leitura informativa (risco de mono-compat), não afeta o áudio
midEnv  = disp_smooth*(midEnv  - mid*mid)   + mid*mid;
sideEnv = disp_smooth*(sideEnv - side*side) + side*side;
side_ratio = sqrt(sideEnv) / (sqrt(midEnv) + 0.0000001);

// --- Medição K-weighted (BS.1770 simplificado) p/ trim de LUFS por plataforma ---
// Estágio 1 - shelf (canal L)
kx = spl0;
ky = k1_b0*kx + k1Lw1;
k1Lw1 = k1_b1*kx - k1_a1*ky + k1Lw2;
k1Lw2 = k1_b2*kx - k1_a2*ky;
s1L = ky;

// Estágio 1 - shelf (canal R)
kx = spl1;
ky = k1_b0*kx + k1Rw1;
k1Rw1 = k1_b1*kx - k1_a1*ky + k1Rw2;
k1Rw2 = k1_b2*kx - k1_a2*ky;
s1R = ky;

// Estágio 2 - highpass RLB (canal L)
kx = s1L;
ky = k2_b0*kx + k2Lw1;
k2Lw1 = k2_b1*kx - k2_a1*ky + k2Lw2;
k2Lw2 = k2_b2*kx - k2_a2*ky;
kL = ky;

// Estágio 2 - highpass RLB (canal R)
kx = s1R;
ky = k2_b0*kx + k2Rw1;
k2Rw1 = k2_b1*kx - k2_a1*ky + k2Rw2;
k2Rw2 = k2_b2*kx - k2_a2*ky;
kR = ky;

k_sq = kL*kL + kR*kR; // pesos 1.0 por canal (estéreo, sem canais surround)

msq_fast = msq_fast_c*(msq_fast - k_sq) + k_sq;
msq_slow = msq_slow_c*(msq_slow - k_sq) + k_sq;

lufs_fast = msq_fast > 0.0000000001 ? -0.691 + 10*log10(msq_fast) : -70;
lufs_slow = msq_slow > 0.0000000001 ? -0.691 + 10*log10(msq_slow) : -70;

// --- Trim: aproxima o nível do alvo da plataforma, com rate-limit (evita zipper) ---
warm_n = min(warm_n+1, warm_len);
confidence = warm_n / warm_len; // 0 no início, 1 depois de ~6s (evita "chute" errado no começo)

trim_bypass == 0 ? (
  trim_target = max(min((target_lufs - lufs_slow + manual_trim_db) * confidence, 12), -12);
  diff = trim_target - trim_db_cur;
  abs(diff) <= max_trim_step ? (
    trim_db_cur = trim_target;
  ) : (
    trim_db_cur = trim_db_cur + (diff > 0 ? max_trim_step : -max_trim_step);
  );
) : (
  trim_db_cur = 0;
);

trim_lin = 10^(trim_db_cur/20);
spl0 *= trim_lin;
spl1 *= trim_lin;

// --- Trim final de saída: ajuste manual único pra "domar" o medidor, sem mexer em Makeup/Tilt ---
out_lin = 10^(out_trim_db/20);
spl0 *= out_lin;
spl1 *= out_lin;

@gfx 260 130
gfx_r=gfx_g=gfx_b=1;
gfx_x=8; gfx_y=8;
gfx_drawstr(sprintf(#dbg, "GR: -%.1f dB", gr_db));
gr_db >= max_gr_db-0.05 ? (
  gfx_r=0.9; gfx_g=0.3; gfx_b=0.2;
  gfx_x=110; gfx_y=8;
  gfx_drawstr("(CLAMP)");
  gfx_r=gfx_g=gfx_b=1;
);
gfx_x=8; gfx_y=26;
gfx_drawstr(sprintf(#dbg2, "Env: %.1f dB | SC-HPF: %.0fHz", env_db, sc_hpf_freq));

// barra de GR
bar_w = min(gr_db*8, 240);
gfx_r=0.9; gfx_g=0.3; gfx_b=0.2;
gfx_rect(8, 44, bar_w, 8);

// leitura de M/S
gfx_r=gfx_g=gfx_b=1;
gfx_x=8; gfx_y=58;
gfx_drawstr(sprintf(#dbg3, "Width: %.0f%% | S/M: %.2f", ms_width, side_ratio));
side_ratio > 0.8 && width_amt > 1.3 ? (
  gfx_r=0.9; gfx_g=0.3; gfx_b=0.2;
  gfx_x=8; gfx_y=74;
  gfx_drawstr("RISCO MONO-COMPAT");
  gfx_r=gfx_g=gfx_b=1;
);

// leitura de LUFS / trim
gfx_x=8; gfx_y=90;
gfx_drawstr(sprintf(#dbg4, "LUFS: %.1f (alvo %.1f) | Trim: %.1fdB", lufs_fast, target_lufs, trim_db_cur));
kw_calibrated == 0 ? (
  gfx_r=0.9; gfx_g=0.6; gfx_b=0.1;
  gfx_x=8; gfx_y=106;
  gfx_drawstr(sprintf(#dbg5, "AVISO: K-weight sem calibração exata p/%.0fHz (usando aprox. 48kHz)", srate));
  gfx_r=gfx_g=gfx_b=1;
);
